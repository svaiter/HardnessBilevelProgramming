Copyright: HardnessBilevel project.

# Semialgebraic sets: definition, Boolean layer, normal forms

Implements blueprint §2.4 and §4.B.1 (ids `sa.gen`, `sa.bool`, `sa.sign_sets`, `sa.sign_normal_form`,
`sa.cell_basic`, `sa.finite_union_basic`, `sa.finite_union_basic_uniform`, `sa.disjoint_basic` (paper Prop C.1)).

* `IsSemialgebraic s` : `s` lies in the Boolean algebra of sets generated by zero sets `{p = 0}` and positivity
  sets `{0 < p}` of real multivariate polynomials (`MeasureTheory.generateSetAlgebra`).
* `IsBasicSA s` : the paper's basic set `{P = 0 ∧ ∀ j, 0 < Q j}` (one equation, finitely many strict inequalities).
* `graphSet`, `IsSemialgebraicMap` : graph of a real function in `ι ⊕ Unit → ℝ`.

The paper's definition (finite unions of basic sets) and Prop C.1 (the union can be taken disjoint) are theorems
here (`isSemialgebraic_iff_finite_union_basic`, `isSemialgebraic_iff_disjoint_union_basic`), proved via the
sign-condition normal form `isSemialgebraic_iff_sign_normal_form` and the explicit uniform cell data
`cellP`, `cellQ` (`setOf_sign_cell_eq`). Erratum E-2 (garbled proof of Prop C.1) is addressed: membership of a
sign cell in a set of the normal form is decided by the sign vector, which is what makes cells "inside or
outside".

Deviations: none in statements. Strengthenings: the finite Boolean closure lemmas take `[Finite κ]` instead of
`[Fintype κ]`. Additional auxiliary declarations: `signCell`, `cellP`, `cellQ`.
-/
import Mathlib

open MeasureTheory Function

namespace Bilevel

section Defs

variable {ι : Type*}

/-- Blueprint §2.4: the Boolean algebra generated by zero sets and positivity sets of polynomials. -/
def IsSemialgebraic (s : Set (ι → ℝ)) : Prop :=
  s ∈ generateSetAlgebra
    (Set.range (fun p : MvPolynomial ι ℝ => {x | MvPolynomial.eval x p = 0}) ∪
     Set.range (fun p : MvPolynomial ι ℝ => {x | 0 < MvPolynomial.eval x p}))

/-- The paper's basic semialgebraic set (Def 2.1): one equation and `k` strict inequalities. -/
def IsBasicSA (s : Set (ι → ℝ)) : Prop :=
  ∃ (P : MvPolynomial ι ℝ) (k : ℕ) (Q : Fin k → MvPolynomial ι ℝ),
    s = {x | MvPolynomial.eval x P = 0 ∧ ∀ j, 0 < MvPolynomial.eval x (Q j)}

/-- Graph of a real function, in `ι ⊕ Unit → ℝ` (value coordinate `Sum.inr ()`). -/
def graphSet (f : (ι → ℝ) → ℝ) : Set (ι ⊕ Unit → ℝ) := {z | f (z ∘ Sum.inl) = z (Sum.inr ())}

/-- A real function is semialgebraic if its graph is. -/
def IsSemialgebraicMap (f : (ι → ℝ) → ℝ) : Prop := IsSemialgebraic (graphSet f)

@[simp] theorem mem_graphSet {f : (ι → ℝ) → ℝ} {z : ι ⊕ Unit → ℝ} :
    z ∈ graphSet f ↔ f (z ∘ Sum.inl) = z (Sum.inr ()) := Iff.rfl

end Defs

section Bool

variable {ι : Type*}

/-- `sa.gen` -/
theorem isSemialgebraic_eval_eq_zero (p : MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | MvPolynomial.eval x p = 0} :=
  self_subset_generateSetAlgebra (Or.inl ⟨p, rfl⟩)

/-- `sa.gen` -/
theorem isSemialgebraic_eval_pos (p : MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | 0 < MvPolynomial.eval x p} :=
  self_subset_generateSetAlgebra (Or.inr ⟨p, rfl⟩)

theorem IsSemialgebraic.of_eq {s t : Set (ι → ℝ)} (hs : IsSemialgebraic s) (h : s = t) :
    IsSemialgebraic t := h ▸ hs

/-- `sa.bool` -/
theorem isSemialgebraic_empty : IsSemialgebraic (∅ : Set (ι → ℝ)) :=
  isSetAlgebra_generateSetAlgebra.empty_mem

/-- `sa.bool` -/
theorem isSemialgebraic_univ : IsSemialgebraic (Set.univ : Set (ι → ℝ)) :=
  isSetAlgebra_generateSetAlgebra.univ_mem

/-- `sa.bool` -/
theorem IsSemialgebraic.compl {s : Set (ι → ℝ)} (hs : IsSemialgebraic s) : IsSemialgebraic sᶜ :=
  isSetAlgebra_generateSetAlgebra.compl_mem hs

/-- `sa.bool` -/
theorem IsSemialgebraic.union {s t : Set (ι → ℝ)} (hs : IsSemialgebraic s) (ht : IsSemialgebraic t) :
    IsSemialgebraic (s ∪ t) :=
  isSetAlgebra_generateSetAlgebra.union_mem hs ht

/-- `sa.bool` -/
theorem IsSemialgebraic.inter {s t : Set (ι → ℝ)} (hs : IsSemialgebraic s) (ht : IsSemialgebraic t) :
    IsSemialgebraic (s ∩ t) :=
  isSetAlgebra_generateSetAlgebra.inter_mem hs ht

/-- `sa.bool` -/
theorem IsSemialgebraic.sdiff {s t : Set (ι → ℝ)} (hs : IsSemialgebraic s) (ht : IsSemialgebraic t) :
    IsSemialgebraic (s \ t) :=
  isSetAlgebra_generateSetAlgebra.sdiff_mem hs ht

theorem isSemialgebraic_compl_iff {s : Set (ι → ℝ)} : IsSemialgebraic sᶜ ↔ IsSemialgebraic s :=
  ⟨fun h => compl_compl s ▸ h.compl, IsSemialgebraic.compl⟩

/-- `sa.bool` -/
theorem isSemialgebraic_biUnion {κ : Type*} (S : Finset κ) {s : κ → Set (ι → ℝ)}
    (hs : ∀ i ∈ S, IsSemialgebraic (s i)) : IsSemialgebraic (⋃ i ∈ S, s i) :=
  isSetAlgebra_generateSetAlgebra.biUnion_mem S hs

/-- `sa.bool` -/
theorem isSemialgebraic_biInter {κ : Type*} (S : Finset κ) {s : κ → Set (ι → ℝ)}
    (hs : ∀ i ∈ S, IsSemialgebraic (s i)) : IsSemialgebraic (⋂ i ∈ S, s i) :=
  isSetAlgebra_generateSetAlgebra.biInter_mem S hs

/-- `sa.bool` (finite index type; `[Finite κ]` is weaker than `[Fintype κ]`). -/
theorem isSemialgebraic_iUnion {κ : Type*} [Finite κ] {s : κ → Set (ι → ℝ)}
    (hs : ∀ i, IsSemialgebraic (s i)) : IsSemialgebraic (⋃ i, s i) := by
  have := Fintype.ofFinite κ
  exact (isSemialgebraic_biUnion Finset.univ (fun i _ => hs i)).of_eq (by simp)

/-- `sa.bool` (finite index type; `[Finite κ]` is weaker than `[Fintype κ]`). -/
theorem isSemialgebraic_iInter {κ : Type*} [Finite κ] {s : κ → Set (ι → ℝ)}
    (hs : ∀ i, IsSemialgebraic (s i)) : IsSemialgebraic (⋂ i, s i) := by
  have := Fintype.ofFinite κ
  exact (isSemialgebraic_biInter Finset.univ (fun i _ => hs i)).of_eq (by simp)

theorem isSemialgebraic_setOf_and {p q : (ι → ℝ) → Prop} (hp : IsSemialgebraic {x | p x})
    (hq : IsSemialgebraic {x | q x}) : IsSemialgebraic {x | p x ∧ q x} :=
  hp.inter hq

theorem isSemialgebraic_setOf_or {p q : (ι → ℝ) → Prop} (hp : IsSemialgebraic {x | p x})
    (hq : IsSemialgebraic {x | q x}) : IsSemialgebraic {x | p x ∨ q x} :=
  hp.union hq

theorem isSemialgebraic_setOf_not {p : (ι → ℝ) → Prop} (hp : IsSemialgebraic {x | p x}) :
    IsSemialgebraic {x | ¬ p x} :=
  hp.compl

theorem isSemialgebraic_setOf_forall {κ : Type*} [Finite κ] {p : κ → (ι → ℝ) → Prop}
    (hp : ∀ i, IsSemialgebraic {x | p i x}) : IsSemialgebraic {x | ∀ i, p i x} :=
  (isSemialgebraic_iInter hp).of_eq (by ext x; simp)

theorem isSemialgebraic_setOf_exists {κ : Type*} [Finite κ] {p : κ → (ι → ℝ) → Prop}
    (hp : ∀ i, IsSemialgebraic {x | p i x}) : IsSemialgebraic {x | ∃ i, p i x} :=
  (isSemialgebraic_iUnion hp).of_eq (by ext x; simp)

end Bool

section SignSets

variable {ι : Type*}

open MvPolynomial

/-- `sa.sign_sets` -/
theorem isSemialgebraic_eval_ne_zero (p : MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | eval x p ≠ 0} :=
  (isSemialgebraic_eval_eq_zero p).compl

/-- `sa.sign_sets` -/
theorem isSemialgebraic_eval_neg (p : MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | eval x p < 0} :=
  (isSemialgebraic_eval_pos (-p)).of_eq (by ext x; simp)

/-- `sa.sign_sets` -/
theorem isSemialgebraic_eval_nonneg (p : MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | 0 ≤ eval x p} :=
  (isSemialgebraic_eval_neg p).compl.of_eq (by ext x; simp)

/-- `sa.sign_sets` -/
theorem isSemialgebraic_eval_nonpos (p : MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | eval x p ≤ 0} :=
  (isSemialgebraic_eval_pos p).compl.of_eq (by ext x; simp)

/-- `sa.sign_sets` -/
theorem isSemialgebraic_eval_lt (p q : MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | eval x p < eval x q} :=
  (isSemialgebraic_eval_pos (q - p)).of_eq (by ext x; simp)

/-- `sa.sign_sets` -/
theorem isSemialgebraic_eval_le (p q : MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | eval x p ≤ eval x q} :=
  (isSemialgebraic_eval_lt q p).compl.of_eq (by ext x; simp)

/-- `sa.sign_sets` -/
theorem isSemialgebraic_eval_eq (p q : MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | eval x p = eval x q} :=
  (isSemialgebraic_eval_eq_zero (p - q)).of_eq (by ext x; simp [sub_eq_zero])

/-- `sa.sign_sets` -/
theorem isSemialgebraic_eval_ne (p q : MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | eval x p ≠ eval x q} :=
  (isSemialgebraic_eval_eq p q).compl

/-- `sa.sign_sets` -/
theorem isSemialgebraic_sign_eval_eq (p : MvPolynomial ι ℝ) (σ : SignType) :
    IsSemialgebraic {x : ι → ℝ | SignType.sign (eval x p) = σ} := by
  cases σ with
  | zero => exact (isSemialgebraic_eval_eq_zero p).of_eq (by ext x; simp)
  | neg => exact (isSemialgebraic_eval_neg p).of_eq (by ext x; simp [sign_eq_neg_one_iff])
  | pos => exact (isSemialgebraic_eval_pos p).of_eq (by ext x; simp [sign_eq_one_iff])

end SignSets

section NormalForm

variable {ι : Type*}

open MvPolynomial

/-- `sa.sign_normal_form` (→): every semialgebraic set is a Boolean condition on the sign vector of finitely
many polynomials. -/
theorem IsSemialgebraic.exists_sign_normal_form {s : Set (ι → ℝ)} (hs : IsSemialgebraic s) :
    ∃ (m : ℕ) (p : Fin m → MvPolynomial ι ℝ) (Φ : (Fin m → SignType) → Prop),
      s = {x | Φ (fun i => SignType.sign (eval x (p i)))} := by
  unfold IsSemialgebraic at hs
  induction hs using generateSetAlgebra_induction with
  | base u hu =>
    rcases hu with ⟨p, rfl⟩ | ⟨p, rfl⟩
    · exact ⟨1, ![p], fun σ => σ 0 = 0, by ext x; simp⟩
    · exact ⟨1, ![p], fun σ => σ 0 = 1, by ext x; simp [sign_eq_one_iff]⟩
  | empty => exact ⟨0, ![], fun _ => False, by ext x; simp⟩
  | compl u _ ih =>
    obtain ⟨m, p, Φ, hu⟩ := ih
    exact ⟨m, p, fun σ => ¬ Φ σ, by rw [hu]; ext x; simp⟩
  | union u v _ _ ihu ihv =>
    obtain ⟨m₁, p₁, Φ₁, hu⟩ := ihu
    obtain ⟨m₂, p₂, Φ₂, hv⟩ := ihv
    refine ⟨m₁ + m₂, Fin.append p₁ p₂,
      fun σ => Φ₁ (fun i => σ (Fin.castAdd m₂ i)) ∨ Φ₂ (fun i => σ (Fin.natAdd m₁ i)), ?_⟩
    rw [hu, hv]; ext x; simp [Fin.append_left, Fin.append_right]

/-- The sign cell of the polynomial tuple `p` with sign vector `σ`. -/
def signCell {m : ℕ} (p : Fin m → MvPolynomial ι ℝ) (σ : Fin m → SignType) : Set (ι → ℝ) :=
  {x | ∀ i, SignType.sign (eval x (p i)) = σ i}

theorem isSemialgebraic_signCell {m : ℕ} (p : Fin m → MvPolynomial ι ℝ) (σ : Fin m → SignType) :
    IsSemialgebraic (signCell p σ) :=
  isSemialgebraic_setOf_forall (fun i => isSemialgebraic_sign_eval_eq (p i) (σ i))

/-- `sa.cell_basic`: cells of distinct sign vectors are disjoint. -/
theorem disjoint_signCell {m : ℕ} (p : Fin m → MvPolynomial ι ℝ) {σ τ : Fin m → SignType} (h : σ ≠ τ) :
    Disjoint (signCell p σ) (signCell p τ) :=
  Set.disjoint_left.2 fun _ hx hy => h (funext fun i => (hx i).symm.trans (hy i))

/-- `sa.cell_basic`: the sign cells cover the space. -/
theorem iUnion_signCell {m : ℕ} (p : Fin m → MvPolynomial ι ℝ) :
    ⋃ σ, signCell p σ = Set.univ :=
  Set.eq_univ_of_forall fun _ => Set.mem_iUnion.2 ⟨_, fun _ => rfl⟩

/-- A sign-condition set is the union of the sign cells it contains. -/
theorem setOf_sign_eq_iUnion_signCell {m : ℕ} (p : Fin m → MvPolynomial ι ℝ)
    (Φ : (Fin m → SignType) → Prop) :
    {x | Φ (fun i => SignType.sign (eval x (p i)))} = ⋃ σ : {σ // Φ σ}, signCell p σ.1 := by
  ext x
  simp only [Set.mem_iUnion]
  constructor
  · intro h
    exact ⟨⟨_, h⟩, fun _ => rfl⟩
  · rintro ⟨⟨σ, hσ⟩, hx⟩
    have : (fun i => SignType.sign (eval x (p i))) = σ := funext hx
    show Φ _
    rw [this]
    exact hσ

/-- `sa.sign_normal_form` (←). -/
theorem isSemialgebraic_setOf_sign {m : ℕ} (p : Fin m → MvPolynomial ι ℝ)
    (Φ : (Fin m → SignType) → Prop) :
    IsSemialgebraic {x | Φ (fun i => SignType.sign (eval x (p i)))} := by
  rw [setOf_sign_eq_iUnion_signCell]
  exact isSemialgebraic_iUnion fun σ => isSemialgebraic_signCell p σ.1

/-- `sa.sign_normal_form` (L5). -/
theorem isSemialgebraic_iff_sign_normal_form {s : Set (ι → ℝ)} :
    IsSemialgebraic s ↔ ∃ (m : ℕ) (p : Fin m → MvPolynomial ι ℝ) (Φ : (Fin m → SignType) → Prop),
      s = {x | Φ (fun i => SignType.sign (eval x (p i)))} := by
  refine ⟨IsSemialgebraic.exists_sign_normal_form, ?_⟩
  rintro ⟨m, p, Φ, rfl⟩
  exact isSemialgebraic_setOf_sign p Φ

/-- Uniform equation of a sign cell: `∑ i, [σ i = 0] p i ^ 2`. -/
noncomputable def cellP {m : ℕ} (p : Fin m → MvPolynomial ι ℝ) (σ : Fin m → SignType) :
    MvPolynomial ι ℝ :=
  ∑ i, if σ i = 0 then p i ^ 2 else 0

/-- Uniform inequalities of a sign cell: `p i`, `-p i` or `1` according to `σ i = 1, -1, 0`. -/
noncomputable def cellQ {m : ℕ} (p : Fin m → MvPolynomial ι ℝ) (σ : Fin m → SignType) :
    Fin m → MvPolynomial ι ℝ :=
  fun i => if σ i = 1 then p i else if σ i = -1 then -p i else 1

private lemma sign_cell_aux (t : ℝ) (σ : SignType) :
    ((σ = 0 → t ^ 2 = 0) ∧ 0 < (if σ = 1 then t else if σ = -1 then -t else 1)) ↔
      SignType.sign t = σ := by
  cases σ <;> simp [sign_eq_one_iff, sign_eq_neg_one_iff]

/-- `sa.cell_basic` (L6): a sign cell is the basic set with the uniform data `cellP`, `cellQ`. -/
theorem signCell_eq_basic {m : ℕ} (p : Fin m → MvPolynomial ι ℝ) (σ : Fin m → SignType) :
    signCell p σ = {x | eval x (cellP p σ) = 0 ∧ ∀ i, 0 < eval x (cellQ p σ i)} := by
  ext x
  have hsum : eval x (cellP p σ) = 0 ↔ ∀ i, σ i = 0 → (eval x (p i)) ^ 2 = 0 := by
    have : eval x (cellP p σ) = ∑ i, if σ i = 0 then (eval x (p i)) ^ 2 else 0 := by
      simp only [cellP, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      split_ifs <;> simp
    rw [this, Finset.sum_eq_zero_iff_of_nonneg (fun i _ => by split_ifs <;> positivity)]
    refine forall_congr' fun i => ?_
    split_ifs with h <;> simp [h]
  have hQ : ∀ i, eval x (cellQ p σ i) =
      if σ i = 1 then eval x (p i) else if σ i = -1 then -eval x (p i) else 1 := by
    intro i
    simp only [cellQ]
    split_ifs <;> simp
  show (∀ i, _) ↔ _ ∧ _
  rw [hsum]
  simp only [hQ, ← forall_and]
  exact forall_congr' fun i => (sign_cell_aux _ _).symm

/-- `sa.cell_basic`: each sign cell is a basic set. -/
theorem isBasicSA_signCell {m : ℕ} (p : Fin m → MvPolynomial ι ℝ) (σ : Fin m → SignType) :
    IsBasicSA (signCell p σ) :=
  ⟨cellP p σ, m, cellQ p σ, signCell_eq_basic p σ⟩

/-- Basic sets are semialgebraic. -/
theorem isSemialgebraic_basic (P : MvPolynomial ι ℝ) {k : ℕ} (Q : Fin k → MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | eval x P = 0 ∧ ∀ j, 0 < eval x (Q j)} :=
  isSemialgebraic_setOf_and (isSemialgebraic_eval_eq_zero P)
    (isSemialgebraic_setOf_forall fun j => isSemialgebraic_eval_pos (Q j))

/-- `sa.finite_union_basic` (⇐ part). -/
theorem isBasicSA_isSemialgebraic {s : Set (ι → ℝ)} (hs : IsBasicSA s) : IsSemialgebraic s := by
  obtain ⟨P, k, Q, rfl⟩ := hs
  exact isSemialgebraic_basic P Q

/-- `sa.disjoint_basic` + `sa.finite_union_basic_uniform`: a semialgebraic set is a finite pairwise disjoint
union of basic sets with a common number `k` of strict inequalities. -/
theorem IsSemialgebraic.exists_disjoint_uniform_basic {s : Set (ι → ℝ)} (hs : IsSemialgebraic s) :
    ∃ (m k : ℕ) (P : Fin m → MvPolynomial ι ℝ) (Q : Fin m → Fin k → MvPolynomial ι ℝ),
      s = (⋃ i, {x | eval x (P i) = 0 ∧ ∀ j, 0 < eval x (Q i j)}) ∧
      Pairwise (Disjoint on fun i => {x : ι → ℝ | eval x (P i) = 0 ∧ ∀ j, 0 < eval x (Q i j)}) := by
  classical
  obtain ⟨k, p, Φ, rfl⟩ := hs.exists_sign_normal_form
  let e := Fintype.equivFin {σ // Φ σ}
  refine ⟨Fintype.card {σ // Φ σ}, k, fun i => cellP p (e.symm i).1, fun i => cellQ p (e.symm i).1,
    ?_, ?_⟩
  · rw [setOf_sign_eq_iUnion_signCell, ← e.symm.surjective.iUnion_comp]
    simp only [signCell_eq_basic]
  · intro i j hij
    simp only [Function.onFun]
    rw [← signCell_eq_basic, ← signCell_eq_basic]
    exact disjoint_signCell p fun h => hij (e.symm.injective (Subtype.ext h))

/-- `sa.finite_union_basic_uniform`: the shape consumed by Thm 2.12. -/
theorem IsSemialgebraic.exists_uniform_basic {s : Set (ι → ℝ)} (hs : IsSemialgebraic s) :
    ∃ (m k : ℕ) (P : Fin m → MvPolynomial ι ℝ) (Q : Fin m → Fin k → MvPolynomial ι ℝ),
      s = ⋃ i, {x | eval x (P i) = 0 ∧ ∀ j, 0 < eval x (Q i j)} := by
  obtain ⟨m, k, P, Q, h, -⟩ := hs.exists_disjoint_uniform_basic
  exact ⟨m, k, P, Q, h⟩

/-- `sa.finite_union_basic_uniform`, as an equivalence. -/
theorem isSemialgebraic_iff_uniform_union_basic {s : Set (ι → ℝ)} :
    IsSemialgebraic s ↔ ∃ (m k : ℕ) (P : Fin m → MvPolynomial ι ℝ) (Q : Fin m → Fin k → MvPolynomial ι ℝ),
      s = ⋃ i, {x | eval x (P i) = 0 ∧ ∀ j, 0 < eval x (Q i j)} := by
  refine ⟨IsSemialgebraic.exists_uniform_basic, ?_⟩
  rintro ⟨m, k, P, Q, rfl⟩
  exact isSemialgebraic_iUnion fun i => isSemialgebraic_basic (P i) (Q i)

/-- `sa.disjoint_basic` (Prop C.1): a set is semialgebraic iff it is a finite pairwise disjoint union of
basic sets. -/
theorem isSemialgebraic_iff_disjoint_union_basic {s : Set (ι → ℝ)} :
    IsSemialgebraic s ↔ ∃ (m : ℕ) (S : Fin m → Set (ι → ℝ)),
      (∀ i, IsBasicSA (S i)) ∧ Pairwise (Disjoint on S) ∧ s = ⋃ i, S i := by
  constructor
  · intro hs
    obtain ⟨m, k, P, Q, h, hd⟩ := hs.exists_disjoint_uniform_basic
    exact ⟨m, _, fun i => ⟨P i, k, Q i, rfl⟩, hd, h⟩
  · rintro ⟨m, S, hS, -, rfl⟩
    exact isSemialgebraic_iUnion fun i => isBasicSA_isSemialgebraic (hS i)

/-- `sa.finite_union_basic` (L7/L8, paper Def 2.1 (A)). -/
theorem isSemialgebraic_iff_finite_union_basic {s : Set (ι → ℝ)} :
    IsSemialgebraic s ↔ ∃ (m : ℕ) (S : Fin m → Set (ι → ℝ)),
      (∀ i, IsBasicSA (S i)) ∧ s = ⋃ i, S i := by
  constructor
  · intro hs
    obtain ⟨m, S, hS, -, h⟩ := isSemialgebraic_iff_disjoint_union_basic.1 hs
    exact ⟨m, S, hS, h⟩
  · rintro ⟨m, S, hS, rfl⟩
    exact isSemialgebraic_iUnion fun i => isBasicSA_isSemialgebraic (hS i)

/-- `sa.disjoint_basic`, uniform form. -/
theorem isSemialgebraic_iff_disjoint_uniform_union_basic {s : Set (ι → ℝ)} :
    IsSemialgebraic s ↔ ∃ (m k : ℕ) (P : Fin m → MvPolynomial ι ℝ) (Q : Fin m → Fin k → MvPolynomial ι ℝ),
      s = (⋃ i, {x | eval x (P i) = 0 ∧ ∀ j, 0 < eval x (Q i j)}) ∧
      Pairwise (Disjoint on fun i => {x : ι → ℝ | eval x (P i) = 0 ∧ ∀ j, 0 < eval x (Q i j)}) := by
  refine ⟨IsSemialgebraic.exists_disjoint_uniform_basic, ?_⟩
  rintro ⟨m, k, P, Q, h, -⟩
  exact isSemialgebraic_iff_uniform_union_basic.2 ⟨m, k, P, Q, h⟩

end NormalForm

end Bilevel
